@page
@using static Microsoft.AspNetCore.Mvc.RazorPages.PageBase;
@using System.Text.RegularExpressions;
@model RegisterModel
@{
    #pragma warning disable CS8602
    ViewData["Title"] = "Register";
}

<h1>@ViewData["Title"]</h1>

<!-- Registration Form -->
<form method="post">
    <fieldset>
        <div>
            <label for="email">Email:</label>
            <input type="text" name="email" asp-for="Email" value="@Model.Email" id="email" placeholder="you@example.com" class="text-black" />
        </div>
        <div>
            <label for="username">Username:</label>
            <input type="text" name="username" asp-for="Username" value="@Model.Username" id="username" placeholder="you" class="text-black" />
        </div>
        <div>
            <label for="password">Password:</label>
            <input type="password" name="password" asp-for="Password" value="@Model.Password" id="pass" class="text-black" />
        </div>
        <div>
            <label for="password">Confirm Password:</label>
            <input type="password" name="confirmpassword" asp-for="ConfirmPassword" value="@Model.ConfirmPassword" id="pass" class="text-black" />
        </div>
        <div>
            <label for="sq">Security Question:</label>
            <input type="text" name="securityquestion" asp-for="SecurityQuestion" value="@Model.SecurityQuestion" id="sq" class="text-black" />
        </div>
        <div>
            <label for="a">Answer:</label>
            <input type="text" name="answer" asp-for="Answer" value="@Model.Answer" id="a" class="text-black" />
        </div>
        <div>
            <label for="checkbox">Verify:</label>
            <input type="checkbox" name="checkbox" asp-for="Checkbox" id="checkbox" class="text-black"/>
        </div>
        <div>
            <label>&nbsp;</label>
            <input type="submit" value="Submit" class="submit" />
        </div>
    </fieldset>
</form>
@{
    var message = TempData["Result"] as string;
}

@if (!string.IsNullOrEmpty(message))
{
    <script>
        alert('@message');
    </script>
}

@if (TempData["Result"] != null && TempData["Result"].ToString().Contains("Account Registered. Logged into "))
{
    <script>
        setTimeout(function () {
            window.location.href = '@Url.Page("Index")';
        }, 0);
    </script>
}