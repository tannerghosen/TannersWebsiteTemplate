@page
@using static Microsoft.AspNetCore.Mvc.RazorPages.PageBase;
@using System.Text.RegularExpressions;
@model SettingsModel
@{
    ViewData["Title"] = "Account Settings";
}

<h1>@ViewData["Title"]</h1>
<a href="Profile/@HttpContext.Session.GetInt32("UserId")">Your Profile</a>
@{
        <form method="post">
            <fieldset>
                @if (Model.IsExternal == false)
                {
                <div>
                    <label for="email">Email:</label>
                    <input type="text" name="email" asp-for="Email" value="" id="email" class="text-black" placeholder="you@example.com" />
                </div>
                }
                <div>
                    <label for="username">Username:</label>
                    <input type="text" name="username" asp-for="Username" value="" id="username" class="text-black" placeholder="you" />
                </div>
                <div>
                    <label for="password">Password:</label>
                    <input type="password" name="password" asp-for="Password" value="" id="pass" class="text-black" />
                </div>
                <div>
                    <label>&nbsp;</label>
                    <input type="submit" value="Submit" class="submit" />
                </div>
            </fieldset>
        </form>
        if (HttpContext.Session.GetInt32("IsAdmin") == 1 && await SQL.Admin.IsAdmin(HttpContext.Session.GetInt32("UserId")))
        {
            <a href="/Admin">Admin Page</a>
        }
}
@{
    var message = TempData["Result"] as string;
}

@if (!string.IsNullOrEmpty(message))
{
    <script>
        alert('@message');
    </script>
}